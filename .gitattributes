# Normalise line endings: the repository stores LF, and every checkout gets LF.
# Without this, Windows checkouts get CRLF (core.autocrlf=true) while CI on Linux
# gets LF, so Prettier passes in one place and fails in the other.
* text=auto eol=lf

# Windows batch files must keep CRLF or cmd.exe mis-parses them.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files must never be line-ending converted.
*.jar binary
*.war binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
