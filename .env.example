# Copy to .env and adjust. .env is git-ignored and must never be committed.
# These values are read by docker-compose.yml.

POSTGRES_DB=ticketdb
POSTGRES_USER=ticket
POSTGRES_PASSWORD=ticket_local_dev_only
POSTGRES_PORT=5432

# Azurite (Blob Storage emulator) ports
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
