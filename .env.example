# Copy to .env and adjust. .env is git-ignored and must never be committed.
# These values are read by docker-compose.yml.

POSTGRES_DB=ticketdb
POSTGRES_USER=ticket
POSTGRES_PASSWORD=ticket_local_dev_only
POSTGRES_PORT=5432

# Azurite (Blob and Queue Storage emulator) ports.
#
# On Windows, WinNAT reserves shifting blocks of ports for its own use, and the
# block often covers Azurite's defaults (10000/10001). If `docker compose up`
# fails with "An attempt was made to access a socket in a way forbidden by its
# access permissions", nothing is listening on the port — Windows has reserved
# it. Check with:
#
#   netsh interface ipv4 show excludedportrange protocol=tcp
#
# and set these to ports outside every listed range, for example 11000/11001.
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
